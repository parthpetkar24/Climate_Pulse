# =============================================================================
# hyperlocal_forecaster/.gitignore
# =============================================================================
# Rules are relative to this file's directory (hyperlocal_forecaster/).
# Git reads this file when staging from anywhere inside the project.
#
# Guiding principle:
#   TRACK everything needed to reproduce, run, or integrate the trained model.
#   IGNORE generated/derived artefacts that are large, machine-specific, or
#   easily regenerated from the tracked source.
# =============================================================================


# -----------------------------------------------------------------------------
# Python bytecode & import caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo


# -----------------------------------------------------------------------------
# Test & tool caches
# -----------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml


# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.env/


# -----------------------------------------------------------------------------
# IDE / editor artefacts
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.code-workspace
*.suo
*.user
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# -----------------------------------------------------------------------------
# Matplotlib runtime cache (created automatically, machine-specific)
# -----------------------------------------------------------------------------
.mplconfig/


# -----------------------------------------------------------------------------
# Jupyter / IPython
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb


# -----------------------------------------------------------------------------
# Temporary and scratch files
# -----------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.log


# -----------------------------------------------------------------------------
# Raw datasets  (original source CSVs — large, unversioned, not needed at
# runtime; reproduced by re-downloading from the source dataset)
# -----------------------------------------------------------------------------
data/raw/


# -----------------------------------------------------------------------------
# Cleaned datasets  (derived from raw; regenerated by running cleaner.py)
# -----------------------------------------------------------------------------
data/cleaned/


# -----------------------------------------------------------------------------
# Processed CSVs and train/val/test split files
# (derived from cleaned data by running preprocessing/pipeline.py;
#  only the scaler pickle and metadata JSON are needed at runtime)
# -----------------------------------------------------------------------------
data/processed/*.csv


# -----------------------------------------------------------------------------
# Augmented .npz window files
# (large binary arrays; regenerated by running augmentation/augmentor.py;
#  not needed at runtime — the trained checkpoint is used for inference)
# -----------------------------------------------------------------------------
data/augmented/*.npz


# -----------------------------------------------------------------------------
# outputs/ — keep only the checkpoint and config; exclude everything else
#
#   TRACKED  (required at runtime / for reproducibility):
#     outputs/best_model.pt       — trained PyTorch state dict
#     outputs/model_config.json   — architecture + scaler constants
#
#   IGNORED  (generated by model.evaluate; easily regenerated):
#     outputs/training_history.json
#     outputs/test_metrics.json
#     outputs/loss_curve.png
#     outputs/actual_vs_predicted.png
#     outputs/horizon_metrics.png
# -----------------------------------------------------------------------------
outputs/training_history.json
outputs/test_metrics.json
outputs/loss_curve.png
outputs/actual_vs_predicted.png
outputs/horizon_metrics.png


# -----------------------------------------------------------------------------
# reports/  — generated logs; exclude the verbose cleaning log but keep
# the data-quality report (human-readable, useful for reference)
# -----------------------------------------------------------------------------
reports/cleaning.log
